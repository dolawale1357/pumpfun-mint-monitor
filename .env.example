# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# Optional. `subscribeNewToken` is a free stream, so this may be left empty.
# With a key: wss://pumpportal.fun/api/data?api-key=...
PUMPPORTAL_API_KEY=

# Required. Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required. The only chat allowed to use /start, /stop, /status, /help.
# Group chat IDs are usually negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional. Default off.
# off -> the PumpPortal stream waits for you to send /start (as documented).
# on  -> monitoring begins the moment the app boots.
#
# Turn this ON if you run on a host that restarts your app on its own
# schedule (most free panels do). Otherwise a restart brings the bot back
# with monitoring OFF and it stays silent until someone sends /start.
# Accepted: true, 1, yes, on
AUTOSTART_MONITORING=false

# Optional. Health endpoint.
#
# Leave BOTH unset on a VPS or a panel. The bot then opens no listening socket
# at all, which is the safest configuration and is how it ran before this
# feature existed.
#
# Render injects PORT automatically, which is what turns the endpoint on there.
# Set HEALTH_PORT by hand on any other host that needs it.
# PORT=10000
# HEALTH_PORT=8080

# Optional. Inbound silence, in seconds, before /health reports "stale" and
# returns 503. The stream normally delivers a token every few seconds, so the
# default of 15 minutes means the socket is almost certainly wedged.
# HEALTH_MAX_IDLE_SECONDS=900

# Optional. Boot grace period, in seconds, before an unconnected socket is
# treated as a fault. Deploys and cold starts need this or they flap.
# HEALTH_STARTUP_GRACE_SECONDS=120
