# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# Optional. `subscribeNewToken` is a free stream, so this may be left empty.
# With a key: wss://pumpportal.fun/api/data?api-key=...
PUMPPORTAL_API_KEY=

# Required. Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required. The only chat allowed to use /start, /stop, /status, /help.
# Group chat IDs are usually negative, e.g. -5394919441
TELEGRAM_CHAT_ID=your_chat_id_here
